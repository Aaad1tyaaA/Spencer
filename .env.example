# Spencer install kit -- settings template.
# Copy to `.env` on the deploy host (docker compose auto-loads `.env`):
#     cp .env.example .env   &&   nano .env
# `.env` is gitignored and must NEVER be committed. Fill every CHANGE_ME value.

# --- Site / TLS ---
# The public hostname. Caddy provisions + renews a Let's Encrypt certificate for
# it automatically (ports 80 + 443 must be open and DNS must point here). Leave
# blank (or ":80") to serve plain HTTP -- used for the local compose proof or when
# behind an external TLS terminator.
SITE_ADDRESS=app.example.com

# --- Auth (REQUIRED) ---
# HS256 signing secret. Generate once: `openssl rand -hex 32`. In production the
# backend REFUSES TO START if this is unset (tokens would otherwise be forgeable).
SPENCER_JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
# Encrypts users' own AI keys (Settings -> AI). Unset -> derived from SPENCER_JWT_SECRET,
# so rotating that secret would make saved keys unreadable. SPENCER_BYOK_ENABLED=false hides the option.
SPENCER_KEY_ENCRYPTION_SECRET=CHANGE_ME_run_openssl_rand_hex_32
SPENCER_JWT_EXPIRY_HOURS=24
# Ships CLOSED: every account can spend your LLM provider quota (bounded per user by
# the AI limits below). See GUIDE.md to create the first account; open it only
# when you are comfortable with that exposure.
SPENCER_ALLOW_REGISTRATION=false
# Public URL of the app, used in links sent to users (password reset, email confirmation).
# Frontend on Vercel: https://<your-app>.vercel.app
SPENCER_FRONTEND_URL=https://app.example.com
# Only when the frontend is on ANOTHER origin (e.g. Vercel): allow it to call this API.
# Comma-separated, exact origins, no trailing slash. Leave unset when Caddy serves both.
# SPENCER_CORS_ORIGINS=https://<your-app>.vercel.app
# New accounts must click the emailed link before uploading (only when SMTP is set).
SPENCER_REQUIRE_EMAIL_VERIFICATION=true
# Refuse sign-ups from disposable/typo/placeholder domains and domains with no mail server.
SPENCER_STRICT_SIGNUP_EMAIL=true

# --- Email allowance ---
# Emails Spencer may send per day (UTC). Brevo's free plan allows 300; once reached,
# sign-up and "forgot password" show "come back tomorrow" instead. 0 = no cap.
SPENCER_EMAIL_DAILY_LIMIT=300

# --- Sign in with Google (optional) ---
# The client ID of a Google Cloud OAuth "Web application" client whose "Authorized
# JavaScript origins" include this site's address. Public, not a secret. Empty = no button.
SPENCER_GOOGLE_CLIENT_ID=

# --- Postgres (identity / ownership store) ---
# Used to run the `db` service AND to build the backend's SPENCER_APP_DB_URL DSN.
# NOTE: the password is interpolated into that URL, so keep it URL-safe -- avoid
# @ : / ? # % (plain letters+digits, or `openssl rand -hex 24`, are safe).
POSTGRES_USER=spencer
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=spencer

# --- LLM providers (optional; supply whichever you use) ---
# Secrets -- keep them only here in the gitignored .env. Multiple comma-separated
# keys rotate on 429 (TASK-024). Leave all blank to run without the AI layer.
GEMINI_API_KEY=
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
SPENCER_LLM_MODEL=
SPENCER_LLM_FALLBACK_MODELS=
# Per-account AI budget (requests to LLM-backed endpoints). 0 disables a limit.
# One shared daily budget across every AI feature; resets at midnight in the timezone below.
SPENCER_AI_PROMPTS_PER_DAY=5
SPENCER_AI_USAGE_TIMEZONE=UTC
SPENCER_AI_REQUESTS_PER_MINUTE=20
# Workspaces each account may have (0 = unlimited).
SPENCER_MAX_WORKSPACES_PER_USER=3

# --- Email (SMTP; any provider: Brevo, Resend SMTP, SES, Gmail app password) ---
# Needed for password-reset and email-confirmation links. Brevo: host smtp-relay.brevo.com,
# port 587, username = your Brevo SMTP login, password = an SMTP key (not your account
# password), FROM = a sender you verified in Brevo.
# Needed for password-reset links. Without it the sign-in page hides "Forgot password?"
# and the endpoint answers 503.
SPENCER_SMTP_HOST=
SPENCER_SMTP_PORT=587
SPENCER_SMTP_USERNAME=
SPENCER_SMTP_PASSWORD=
SPENCER_SMTP_FROM=Spencer <no-reply@example.com>
SPENCER_SMTP_STARTTLS=true
SPENCER_SMTP_SSL=false

# --- Backups of the analytical DuckDB (written to the backend volume, /data/backups) ---
SPENCER_BACKUP_INTERVAL_HOURS=24
SPENCER_BACKUP_KEEP=7

# --- Sizing / lifecycle (optional; sensible defaults if omitted) ---
# Reclaim an owned workspace after this many idle days (0 = keep forever).
SPENCER_OWNED_RETENTION_DAYS=0
SPENCER_OWNED_SESSION_TTL_DAYS=30
# Largest upload in MB. The hosted web app keeps 100. On your own install you can raise it
# (e.g. 500), then set MAX_REQUEST_BODY a little higher so Caddy lets it through (510MB).
SPENCER_MAX_UPLOAD_MB=100
MAX_REQUEST_BODY=110MB
# DuckDB RAM ceiling: about a third of the VM's RAM. Always Free A1 (12 GB): 4GB DuckDB
# inside a 7g backend container. On a 24 GB VM use 8GB and BACKEND_MEM_LIMIT=14g.
SPENCER_DUCKDB_MEMORY_LIMIT=4GB
BACKEND_MEM_LIMIT=7g

# --- Public site extras (optional; the web image must be rebuilt to pick them up) ---
# Cookieless Plausible analytics. Leave blank for none (then no consent banner shows).
# PLAUSIBLE_SRC only for a self-hosted Plausible; default is https://plausible.io/js/script.js
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=
# Origin the Content-Security-Policy allows for that script, e.g. https://plausible.io
PLAUSIBLE_ORIGIN=
# Shown on the privacy and terms pages as the contact address.
CONTACT_EMAIL=

# --- Version ---
# Pin a release (e.g. 1.2.0); empty = latest.
SPENCER_VERSION=
